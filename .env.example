# ── Server-only (no NEXT_PUBLIC_ prefix = never exposed to browser) ──────────
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ── Client-safe (NEXT_PUBLIC_ prefix = visible in browser bundle) ─────────────
# WalletConnect Project ID — get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ── Optional ──────────────────────────────────────────────────────────────────
# CoinGecko Demo API key — raises rate limit from ~10 to 30 req/min
# Get free key at https://www.coingecko.com/en/developers/dashboard
# COINGECKO_API_KEY=your_key_here
